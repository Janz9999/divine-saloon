rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 5 * 1024 * 1024;
    }
    function isManager() {
      return request.auth != null
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    // Each person's profile photo: only they can change it; only they read it.
    match /profilePhotos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
    }

    // Gallery photos: anyone signed in can view; only the manager uploads/deletes.
    match /gallery/{id} {
      allow read: if request.auth != null;
      allow create, update: if isManager() && isImage();
      allow delete: if isManager();
    }
  }
}
